# ---- Persistent storage config (production only) ----
# Leave ALL of these EMPTY for local development:
# the app automatically falls back to SQLite + local disk.

# Railway PostgreSQL — Railway injects this automatically once you add
# a PostgreSQL service. You normally do NOT set it by hand.
DATABASE_URL=

# Aliyun OSS — fill these in on Railway (Variables tab) to enable cloud photo storage.
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# Optional: folder prefix inside the bucket (default: film-roll/)
OSS_PREFIX=film-roll/

# ---- AI caption (小红书文案) ----
# Aliyun 百炼 (DashScope) API Key — enables the "生成文案" feature.
# Get it at https://bailian.console.aliyun.com/ (this is NOT the OSS AccessKey).
DASHSCOPE_API_KEY=
# Optional: override the model (default: qwen-vl-max)
DASHSCOPE_MODEL=qwen-vl-max

